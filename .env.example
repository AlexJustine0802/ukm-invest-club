# ---------------------------------------------------------------------------
# ICUnpar website  environment variables
# Copy this file to `.env` and fill in real values.
# ---------------------------------------------------------------------------

# PostgreSQL connection string (Supabase, Neon, or any Postgres).
#
# Supabase: both URLs must use the SAME project ref and the same pooler host.
# If they drift apart, `prisma db push` writes to one database while the site
# reads another. See docs/db-troubleshooting.md.
#
# Runtime. Port 6543 is Supavisor TRANSACTION mode.
#   pgbouncer=true      transaction mode cannot carry prepared statements
#   connection_limit=5  one serverless function serves one request at a time
#   connect_timeout=15  a paused project takes longer to wake than the 5s default
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5&pool_timeout=20&connect_timeout=15"

# Migrations only (prisma migrate / db push / studio). Port 5432 is SESSION
# mode, which supports the DDL and advisory locks Prisma needs.
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Secret used to sign the admin session cookie (JWT).
# Generate one with:  openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"

# --- Admin login (single shared account) ---
ADMIN_USERNAME="admin"
# Password hash. Generate the value with:  npm run hash-password -- "YourPassword"
# (It is base64-encoded so it has no "$" characters that .env would mangle.)
ADMIN_PASSWORD_HASH="replace_with_generated_value"

# --- Contact form + authentication email (Resend) ---
# Create a key at https://resend.com/api-keys
RESEND_API_KEY=""
# Where contact-form messages are delivered:
CONTACT_EMAIL_TO="icunpar@example.com"
# Sender used by both contact and verify/reset emails. The domain must be
# verified in Resend before sending to users outside your Resend account.
CONTACT_EMAIL_FROM="ICUnpar Website <onboarding@resend.dev>"

# --- Image uploads (optional) ---
# Vercel Blob token. If unset, admins can still paste image URLs manually.
BLOB_READ_WRITE_TOKEN=""

# Public base URL of the site (used in emails/metadata). Optional in dev.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
