generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Pooled, transaction mode (port 6543)  every runtime query.
  url       = env("DATABASE_URL")
  // Session mode (port 5432)  migrations only. Prisma needs advisory locks
  // and DDL that the transaction pooler cannot carry.
  directUrl = env("DIRECT_URL")
}

model Event {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String   @db.Text
  eventDate   DateTime
  location    String?
  coverImage  String?
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  categoryId String?
  category   EventCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  featured   Boolean        @default(false) // ticked to show in the events hero

  // Member-area registration
  endDate  DateTime? // end of the session; drives the "13.00 – 16.00" range
  capacity Int? // null = unlimited, no seat counter shown
  seatUnit String    @default("seats") // "seats" or "teams"

  registrations EventRegistration[]

  // The form OWNS the event: an event exists only as the public face of its
  // registration form, and is created, updated and deleted through it. Required
  // + unique + cascade is what makes "no event without a form" a database rule
  // rather than a convention someone can forget.
  registrationFormId String           @unique
  registrationForm   RegistrationForm @relation(fields: [registrationFormId], references: [id], onDelete: Cascade)

  @@index([eventDate])
  @@index([categoryId])
}

// One row per member per event. The unique pair makes double-registering
// impossible even if the button is clicked twice.
model EventRegistration {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([eventId, userId])
  @@index([userId])
}

model EventCategory {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String?
  icon        String   @default("Building2")
  color       String? // badge / button colour on the member events page
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  events      Event[]

  @@index([order])
}

model Publication {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String    @db.Text
  content     String    @db.Text
  coverImage  String?
  author      String?
  published   Boolean   @default(true)
  publishedAt DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  categoryId    String?
  category      ResearchCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  featured      Boolean           @default(false)
  featuredOrder Int               @default(0)
  pageCount     Int?
  badge         String?

  @@index([publishedAt])
  @@index([categoryId])
  @@index([featured, featuredOrder])
}

model ResearchCategory {
  id           String        @id @default(cuid())
  title        String
  slug         String        @unique
  description  String?
  icon         String        @default("PieChart")
  order        Int           @default(0)
  createdAt    DateTime      @default(now())
  publications Publication[]

  @@index([order])
}

// DEPRECATED  the public About page builds its people from User accounts
// (/admin/members). Nothing reads this table; kept so `db push` does not drop it
// behind your back. Safe to delete with a deliberate push.
model TeamMember {
  id        String  @id @default(cuid())
  name      String
  role      String
  photo     String?
  bio       String? @db.Text
  order     Int     @default(0)
  linkedin  String?
  instagram String?
  createdAt DateTime @default(now())

  @@index([order])
}

model User {
  id            String      @id @default(cuid())
  name          String
  email         String      @unique
  // Collected at signup. Optional in the schema so accounts created before it
  // existed stay valid; the signup form asks for it.
  phone         String?
  passwordHash  String
  role          String      @default("Member") // a role from lib/roles.ts
  division      String? // division slug from lib/roles.ts; null = no division yet

  // Public profile. A member with a division and role is shown in "Our
  // Divisions" on the public About page, so these are edited once in
  // /admin/members and appear in both places.
  photo     String?
  bio       String? @db.Text
  instagram String?
  linkedin  String?
  emailVerified DateTime?
  createdAt     DateTime    @default(now())
  authTokens    AuthToken[]

  eventRegistrations EventRegistration[]
  channelMembers     ChannelMember[]
  discussionPosts    DiscussionPost[]
  formResponses      FormResponse[]
  submissions        AssignmentSubmission[]
  notificationReads  NotificationRead[]
}

// Bell notifications are derived from other tables (announcements, career
// alerts, marked submissions) rather than stored, so "read" cannot live on the
// notification itself. One row per member per notification key marks it read;
// no row means unread, which is why nothing has to be written when a new
// notification appears.
model NotificationRead {
  id     String   @id @default(cuid())
  userId String
  // The notification's own id, e.g. "graded-<submissionId>" or an announcement
  // row id  whatever getTopBarNotifications used.
  key    String
  readAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([userId])
}

// A discussion channel members opt into. Only admins create channels; members
// join, and joining is what unlocks reading and posting.
model DiscussionChannel {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  icon        String? // key from lib/uiIcons
  color       String? // palette key from lib/eventStyles
  order       Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members ChannelMember[]
  posts   DiscussionPost[]

  @@index([published, order])
}

// Same shape as EventRegistration: the unique pair makes a double click a no-op.
model ChannelMember {
  id        String            @id @default(cuid())
  channelId String
  channel   DiscussionChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime          @default(now())

  @@unique([channelId, userId])
  @@index([userId])
}

// A Google-Forms-style registration: staff recruitment, event sign-up, anything
// with a custom question list. The questions live in one JSON column (see
// lib/forms.ts for the shape) because they are only ever read and written as a
// whole form  a table per question would buy nothing.
model RegistrationForm {
  id          String  @id @default(cuid())
  title       String
  slug        String  @unique
  description String? @db.Text
  coverImage  String?

  audience          String  @default("MEMBERS") // MEMBERS | PUBLIC | BOTH
  multipleResponses Boolean @default(false) // false = one response per member
  questions         Json    @default("[]") // FormQuestion[] from lib/forms.ts

  // Ticked on the club's open-recruitment form. The newest one drives
  // /account/recruitment; when none is open that page shows a closed notice.
  isRecruitment Boolean @default(false)

  // Off for events that need no sign-up (an open talk, a notice). The Register
  // button disappears from the public and member event pages and the form
  // stops accepting responses. Defaults on so existing events keep theirs.
  registrationEnabled Boolean @default(true)

  // Announced on the member Announcements page and dashboard rail. Reads as
  // the event, the recruitment round or the sign-up, depending on the form.
  announced Boolean @default(false)

  opensAt   DateTime?
  closesAt  DateTime?
  capacity  Int? // null = unlimited
  published Boolean   @default(true)
  order     Int       @default(0)
  icon      String? // key from lib/uiIcons
  color     String? // palette key from lib/eventStyles

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  responses FormResponse[]

  // The public event this form is the sign-up for. Null for forms that are not
  // events (recruitment, standalone sign-ups).
  event Event?

  @@index([published, order])
}

// One submission. `answers` is keyed by question id; file answers hold the
// uploaded blob URL. Guests (public forms) have no userId, so their name and
// email are captured on the row itself.
model FormResponse {
  id     String           @id @default(cuid())
  formId String
  form   RegistrationForm @relation(fields: [formId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  guestName  String?
  guestEmail String?

  answers   Json     @default("{}")
  createdAt DateTime @default(now())

  @@index([formId, createdAt])
  @@index([userId])
}

// Job / internship openings on /account/career. Publishing one makes it show up
// in the member notification bell automatically  there is no separate
// announcement row to keep in sync.
model CareerAlert {
  id          String    @id @default(cuid())
  company     String
  role        String
  location    String?
  workType    String    @default("Internship") // e.g. Internship, Full-time, Part-time
  description String?   @db.Text
  applyUrl    String?
  deadline    DateTime?
  icon        String? // key from lib/uiIcons
  color       String? // palette key from lib/eventStyles
  published   Boolean   @default(true)
  // Also listed on the member Announcements page and dashboard rail. One flag,
  // no copied row to keep in step with the alert it describes.
  announced   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([published, createdAt])
}

model DiscussionPost {
  id        String            @id @default(cuid())
  channelId String
  channel   DiscussionChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  body      String            @db.Text
  createdAt DateTime          @default(now())

  @@index([channelId, createdAt])
}

// Single-use tokens for email verification and password reset.
// Only the SHA-256 hash is stored, so a DB leak cannot be replayed.
model AuthToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  type      String // "VERIFY" | "RESET"
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId, type])
}

// Promo banner at the top of the member dashboard (e.g. staff recruitment).
// Only the newest active row is shown.
model Highlight {
  id          String   @id @default(cuid())
  eyebrow     String // small label above the title, e.g. "Open Recruitment"
  title       String
  description String?  @db.Text
  buttonLabel String?
  buttonHref  String?
  noteTitle   String? // optional small side card
  noteBody    String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active, createdAt])
}

// Editable content blocks on the member dashboard. One model with a `section`
// discriminator (same pattern as ImpactStat) instead of one table per widget.
//   overview     title=label     subtitle=value    note=change
//   announcement title           subtitle=body     meta=detail   badge=category note=age
//   resource     title           subtitle=lesson   badge=tag     note=age
//   discussion   title           meta=category & replies         note=age
//   deadline     title           subtitle=due in   meta=date
//   career       title=company   subtitle=role     meta=location badge=New
//   folder       title=name      meta=count        badge=category
model DashboardItem {
  id       String  @id @default(cuid())
  section  String
  title    String
  subtitle String?
  meta     String?
  note     String?
  badge    String?
  icon     String? // key from lib/uiIcons
  color    String? // tailwind classes, e.g. "bg-blue-50 text-primary"
  href     String?
  order    Int     @default(0)
  active   Boolean @default(true)

  // Overview cards only: a key from lib/metrics. When set, the card's value is
  // counted live instead of being typed in by hand.
  metric String?

  // "folder" section only: what members see after opening the folder.
  materials ResourceMaterial[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([section, active, order])
}

// One entry inside a resource folder  a link or a file members can open.
// Folders themselves are DashboardItem rows in the "folder" section; deleting
// one takes its materials with it.
model ResourceMaterial {
  id          String  @id @default(cuid())
  folderId    String
  title       String
  description String?
  url         String
  // Free text under the title, e.g. "PDF · 12 pages".
  meta   String?
  order  Int     @default(0)
  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  folder DashboardItem @relation(fields: [folderId], references: [id], onDelete: Cascade)

  @@index([folderId, active, order])
}

// "Our Divisions" on the About page: the division's own description and icon.
// Its people are User rows with a matching `division` slug  one record per
// person, edited in /admin/members, shown in both the member and public sites.
// DEPRECATED  the org chart is hardcoded in lib/roles.ts (DIVISIONS) and is not
// admin-editable. Nothing reads this table any more; kept only so `db push` does
// not drop it behind your back. Safe to delete with a deliberate push.
model Division {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  tagline     String? // sub-roles, e.g. "President, Vice President, Controller"
  description String? @db.Text
  icon        String? // key from lib/uiIcons
  order       Int     @default(0)

  createdAt DateTime @default(now())

  @@index([order])
}

// Member-area assignments. dueDate is a real date so "Due in N days" and the
// "Due Soon" bucket stay correct without anyone re-typing them.
model Assignment {
  id          String   @id @default(cuid())
  title String
  // Nullable since the admin form stopped asking for these; existing rows keep
  // whatever was typed in before.
  category    String?
  workType    String?
  description String?   @db.Text
  // Null means open from the moment it is published. Set, and members can see
  // it but cannot submit until this passes  the nullable column is the
  // "needs an open date" switch, there is no second flag to keep in step.
  opensAt DateTime?
  dueDate DateTime
  // Not editable any more  a member's own submission decides what they see,
  // see memberStatus in lib/assignments. Kept as the fallback for anyone who
  // has not submitted.
  status String  @default("ACTIVE") // ACTIVE | SUBMITTED | COMPLETED
  icon   String?
  color  String?
  href        String?
  // The question paper, uploaded in the admin form. `href` stays the "link to
  // it somewhere else" option; a file here is the copy members download.
  fileUrl     String?
  fileName    String?
  order       Int      @default(0)
  published   Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  submissions AssignmentSubmission[]

  @@index([published, status, dueDate])
}

// One submission per member per assignment: the member uploads a file, the
// admin marks it with a score and feedback.
model AssignmentSubmission {
  id           String     @id @default(cuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  fileUrl  String?
  fileName String?
  note     String? @db.Text

  // Marking. gradedAt set = the member sees their score.
  score    Int?
  feedback String?   @db.Text
  gradedAt DateTime?

  submittedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([assignmentId, userId])
  @@index([assignmentId, submittedAt])
  @@index([userId])
}

// What one role may do in the admin workspace. A missing row means "nothing":
// every role starts denied and the super admin switches things on.
//
// The role string is the primary key because role names are unique across the
// whole org chart  scripts/check-roles.ts asserts it  so no division column
// is needed. Permissions live in one JSON blob rather than a row per toggle:
// the editor saves the whole grid at once, so a blob is one write instead of a
// delete-all + insert-many, and there is no join table to keep in step with
// lib/permissions.ts. Same trade-off as RegistrationForm.questions.
model RolePermission {
  role        String   @id // a role from lib/roles.ts
  permissions Json     @default("{}") // { "events": ["view", "create"], ... }
  updatedAt   DateTime @updatedAt
}

model SiteSettings {
  id             Int      @id @default(1) // singleton row
  homeAboutImage String? // home "About Us" strip picture
  aboutHeroImage String? // about page hero image

  // Which automatic bell notifications members receive. Announcements are not
  // listed: those are written by hand and are the whole point of the bell.
  // Default on, so turning the feature off is a deliberate act.
  notifyAssignments  Boolean @default(true)
  notifyMaterials    Boolean @default(true)
  notifyEvents       Boolean @default(true)
  notifyDiscussions  Boolean @default(true)
  notifyRecruitment  Boolean @default(true)
  notifyCareer       Boolean @default(true)

  updatedAt DateTime @updatedAt
}

model HeroSlide {
  id       String @id @default(cuid())
  location String // "home" | "about"
  imageUrl String

  // home hero fields
  eyebrow     String?
  titleStart  String?
  highlight   String?
  titleEnd    String?
  description String? @db.Text

  // about slideshow fields
  title    String?
  subtitle String?
  caption  String? // e.g. date label
  icon     String? // lucide name for the about card

  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([location, order])
}

model ImpactStat {
  id      String @id @default(cuid())
  label   String
  value   String
  icon    String @default("TrendingUp")
  section String @default("home") // "home" (shared home+about) | "research"
  order   Int    @default(0)

  @@index([section, order])
}

model Partner {
  id      String  @id @default(cuid())
  name    String
  logoUrl String?
  order   Int     @default(0)

  // Which public section this partner appears under. Values come from
  // lib/partners.ts (COMPANY | COMMUNITY_MEDIA); existing rows default to
  // COMPANY so nothing disappears from the site when this column is added.
  category String @default("COMPANY")

  @@index([order])
}

model Moment {
  id         String        @id @default(cuid())
  title      String
  category   String
  date       DateTime
  coverImage String
  order      Int           @default(0)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  photos     MomentPhoto[]

  @@index([order])
  @@index([category])
}

model MomentPhoto {
  id        String   @id @default(cuid())
  momentId  String
  moment    Moment   @relation(fields: [momentId], references: [id], onDelete: Cascade)
  imageUrl  String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([momentId, order])
}
