generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Event {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String   @db.Text
  eventDate   DateTime
  location    String?
  coverImage  String?
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  categoryId String?
  category   EventCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  featured   Boolean        @default(false) // ticked to show in the events hero

  @@index([eventDate])
  @@index([categoryId])
}

model EventCategory {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String?
  icon        String   @default("Building2")
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  events      Event[]

  @@index([order])
}

model Publication {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String    @db.Text
  content     String    @db.Text
  coverImage  String?
  author      String?
  published   Boolean   @default(true)
  publishedAt DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  categoryId    String?
  category      ResearchCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  featured      Boolean           @default(false)
  featuredOrder Int               @default(0)
  pageCount     Int?
  badge         String?

  @@index([publishedAt])
  @@index([categoryId])
  @@index([featured, featuredOrder])
}

model ResearchCategory {
  id           String        @id @default(cuid())
  title        String
  slug         String        @unique
  description  String?
  icon         String        @default("PieChart")
  order        Int           @default(0)
  createdAt    DateTime      @default(now())
  publications Publication[]

  @@index([order])
}

model TeamMember {
  id        String  @id @default(cuid())
  name      String
  role      String
  photo     String?
  bio       String? @db.Text
  order     Int     @default(0)
  linkedin  String?
  instagram String?
  createdAt DateTime @default(now())

  @@index([order])
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model SiteSettings {
  id             Int      @id @default(1) // singleton row
  homeAboutImage String? // home "About Us" strip picture
  aboutHeroImage String? // about page hero image
  updatedAt      DateTime @updatedAt
}

model HeroSlide {
  id       String @id @default(cuid())
  location String // "home" | "about"
  imageUrl String

  // home hero fields
  eyebrow     String?
  titleStart  String?
  highlight   String?
  titleEnd    String?
  description String? @db.Text

  // about slideshow fields
  title    String?
  subtitle String?
  caption  String? // e.g. date label
  icon     String? // lucide name for the about card

  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([location, order])
}

model ImpactStat {
  id      String @id @default(cuid())
  label   String
  value   String
  icon    String @default("TrendingUp")
  section String @default("home") // "home" (shared home+about) | "research"
  order   Int    @default(0)

  @@index([section, order])
}

model Partner {
  id      String  @id @default(cuid())
  name    String
  logoUrl String?
  order   Int     @default(0)

  @@index([order])
}

model Moment {
  id         String        @id @default(cuid())
  title      String
  category   String
  date       DateTime
  coverImage String
  order      Int           @default(0)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  photos     MomentPhoto[]

  @@index([order])
  @@index([category])
}

model MomentPhoto {
  id        String   @id @default(cuid())
  momentId  String
  moment    Moment   @relation(fields: [momentId], references: [id], onDelete: Cascade)
  imageUrl  String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([momentId, order])
}
